rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null && request.auth.token.email == 'juyeonglee911029@gmail.com';
    }
    function isAdultUser(userId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.age is int
        && get(/databases/$(database)/documents/profiles/$(userId)).data.age >= 18;
    }
    function isAccountAllowed(userId) {
      return !exists(/databases/$(database)/documents/accountModeration/$(userId))
        || get(/databases/$(database)/documents/accountModeration/$(userId)).data.status == 'active'
        || (get(/databases/$(database)/documents/accountModeration/$(userId)).data.status == 'suspended'
          && get(/databases/$(database)/documents/accountModeration/$(userId)).data.until is timestamp
          && request.time >= get(/databases/$(database)/documents/accountModeration/$(userId)).data.until);
    }
    function hasValidGender(data) {
      return data.keys().hasAny(['gender']) && (data.gender == 'male' || data.gender == 'female');
    }
    function hasValidCountry(data) {
      return data.keys().hasAny(['country'])
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.country != 'Global';
    }
    function hasValidAge(data) {
      return data.keys().hasAny(['age'])
        && data.age is int
        && data.age >= 13
        && data.age <= 130;
    }
    function hasCompletedOnboarding(data) {
      return hasValidGender(data) && hasValidCountry(data) && hasValidAge(data);
    }
     function isSafeGalleryPhotoUrl(value) {
       return value is string
         && value.size() <= 2048
         && value.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/gyopo-live-portal-506019\\.firebasestorage\\.app/o/profiles%2F[^/?&]+%2Fgallery%2F[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.jpg\\?alt=media&token=[A-Za-z0-9_-]{16,256}$');
     }
     function hasSafeProfilePhotos(data, userId) {
       return !data.keys().hasAny(['profilePhotos'])
         || (data.profilePhotos is list
           && data.profilePhotos.size() <= 5
           && (data.profilePhotos.size() < 1 || isSafeGalleryPhotoUrl(data.profilePhotos[0]))
           && (data.profilePhotos.size() < 2 || isSafeGalleryPhotoUrl(data.profilePhotos[1]))
           && (data.profilePhotos.size() < 3 || isSafeGalleryPhotoUrl(data.profilePhotos[2]))
           && (data.profilePhotos.size() < 4 || isSafeGalleryPhotoUrl(data.profilePhotos[3]))
           && (data.profilePhotos.size() < 5 || isSafeGalleryPhotoUrl(data.profilePhotos[4]))
           && (data.profilePhotos.size() < 2 || data.profilePhotos[0] != data.profilePhotos[1])
           && (data.profilePhotos.size() < 3 || (data.profilePhotos[0] != data.profilePhotos[2] && data.profilePhotos[1] != data.profilePhotos[2]))
           && (data.profilePhotos.size() < 4 || (data.profilePhotos[0] != data.profilePhotos[3] && data.profilePhotos[1] != data.profilePhotos[3] && data.profilePhotos[2] != data.profilePhotos[3]))
           && (data.profilePhotos.size() < 5 || (data.profilePhotos[0] != data.profilePhotos[4] && data.profilePhotos[1] != data.profilePhotos[4] && data.profilePhotos[2] != data.profilePhotos[4] && data.profilePhotos[3] != data.profilePhotos[4]))
            && (data.profilePhotos.size() == 0
              || (exists(/databases/$(database)/documents/verifiedProfilePhotos/$(userId))
                && get(/databases/$(database)/documents/verifiedProfilePhotos/$(userId)).data.get('profilePhotos', []) == data.profilePhotos)));
     }
     function verifiedGalleryHasMinimum(userId) {
       let publicPhotos = get(/databases/$(database)/documents/publicProfiles/$(userId)).data.get('profilePhotos', []);
       let verifiedPhotos = get(/databases/$(database)/documents/verifiedProfilePhotos/$(userId)).data.get('profilePhotos', []);
       return publicPhotos is list && verifiedPhotos is list
         && publicPhotos == verifiedPhotos
         && publicPhotos.size() >= 3 && publicPhotos.size() <= 5;
     }
     function hasVerifiedPublicGallery(userId) {
       return exists(/databases/$(database)/documents/publicProfiles/$(userId))
         && exists(/databases/$(database)/documents/verifiedProfilePhotos/$(userId))
         && verifiedGalleryHasMinimum(userId);
     }
     function hasMatchablePublicPhotos(userId) {
       return hasVerifiedPublicGallery(userId);
     }
     function hasValidDirectWebrtcTarget(data) {
       return data.keys().hasAny(['targetUserId'])
         && data.targetUserId is string
         && data.targetUserId.size() > 0
         && data.targetUserId.size() <= 128
         && !data.targetUserId.matches('.*[/].*');
     }
     function canonicalFriendshipId(first, second) {
       return first < second ? 'friend-' + first + '-' + second : 'friend-' + second + '-' + first;
     }
     function isAcceptedFriendshipRecord(collection, friendshipId, userId, targetUserId) {
       return exists(/databases/$(database)/documents/$(collection)/$(friendshipId))
         && get(/databases/$(database)/documents/$(collection)/$(friendshipId)).data.get('status', '') == 'accepted'
         && ((get(/databases/$(database)/documents/$(collection)/$(friendshipId)).data.get('requesterId', '') == userId
             && get(/databases/$(database)/documents/$(collection)/$(friendshipId)).data.get('addresseeId', '') == targetUserId)
           || (get(/databases/$(database)/documents/$(collection)/$(friendshipId)).data.get('requesterId', '') == targetUserId
             && get(/databases/$(database)/documents/$(collection)/$(friendshipId)).data.get('addresseeId', '') == userId));
     }
      function hasAcceptedFriendship(userId, targetUserId) {
        let friendshipId = canonicalFriendshipId(userId, targetUserId);
        return userId != targetUserId
          && (isAcceptedFriendshipRecord('friendships', friendshipId, userId, targetUserId)
            || (!exists(/databases/$(database)/documents/friendships/$(friendshipId))
              && isAcceptedFriendshipRecord('webrtcCalls', friendshipId, userId, targetUserId)));
     }
     function isValidWebrtcGamePair(gameType, gameRoomId, userId, targetUserId) {
       return userId != targetUserId
         && gameRoomId is string
         && gameRoomId.size() > 0
         && gameRoomId.size() <= 128
         && !gameRoomId.matches('.*[/].*')
         && (
           (gameType == 'tetris'
             && exists(/databases/$(database)/documents/tetrisRoomAccess/$(gameRoomId))
             && get(/databases/$(database)/documents/tetrisRoomAccess/$(gameRoomId)).data.get('active', false) == true
             && ((get(/databases/$(database)/documents/tetrisRoomAccess/$(gameRoomId)).data.get('playerAId', '') == userId
                   && get(/databases/$(database)/documents/tetrisRoomAccess/$(gameRoomId)).data.get('playerBId', '') == targetUserId)
               || (get(/databases/$(database)/documents/tetrisRoomAccess/$(gameRoomId)).data.get('playerAId', '') == targetUserId
                   && get(/databases/$(database)/documents/tetrisRoomAccess/$(gameRoomId)).data.get('playerBId', '') == userId)))
           || (gameType == 'brickBreaker'
             && exists(/databases/$(database)/documents/brickBreakerRooms/$(gameRoomId))
             && get(/databases/$(database)/documents/brickBreakerRooms/$(gameRoomId)).data.get('status', '') != 'closed'
             && ((get(/databases/$(database)/documents/brickBreakerRooms/$(gameRoomId)).data.get('host', '') == userId
                   && get(/databases/$(database)/documents/brickBreakerRooms/$(gameRoomId)).data.get('guest', '') == targetUserId)
               || (get(/databases/$(database)/documents/brickBreakerRooms/$(gameRoomId)).data.get('host', '') == targetUserId
                   && get(/databases/$(database)/documents/brickBreakerRooms/$(gameRoomId)).data.get('guest', '') == userId)))
         );
     }
     function hasNoWebrtcDirectTarget(data) {
       return !data.keys().hasAny(['targetUserId']) || data.get('targetUserId', null) == null;
     }
     function hasNoWebrtcGameDetails(data) {
       return (!data.keys().hasAny(['gameType']) || data.get('gameType', null) == null)
         && (!data.keys().hasAny(['gameRoomId']) || data.get('gameRoomId', null) == null);
     }
     function isRandomWebrtcQueue(data) {
       return (data.get('queueKind', '') == 'random' || data.get('queueKind', '') == '')
         && hasNoWebrtcDirectTarget(data)
         && hasNoWebrtcGameDetails(data);
     }
     function isFriendWebrtcQueue(data, userId) {
       return (data.get('queueKind', '') == 'friend' || data.get('queueKind', '') == '')
         && hasValidDirectWebrtcTarget(data)
         && hasNoWebrtcGameDetails(data)
         && hasAcceptedFriendship(userId, data.targetUserId);
     }
     function isGameWebrtcQueue(data, userId) {
       return data.get('queueKind', '') == 'game'
         && hasValidDirectWebrtcTarget(data)
         && data.get('gameType', '') in ['tetris', 'brickBreaker']
         && data.keys().hasAny(['gameRoomId'])
         && isValidWebrtcGamePair(data.gameType, data.gameRoomId, userId, data.targetUserId);
     }
     function isValidWebrtcQueueKind(data, userId) {
       return isRandomWebrtcQueue(data)
         || isFriendWebrtcQueue(data, userId)
         || isGameWebrtcQueue(data, userId);
     }
     function hasReciprocalWebrtcQueue(firstId, firstData, secondId, secondData) {
       return firstData.get('userId', '') == firstId
         && secondData.get('userId', '') == secondId
         && firstData.get('status', '') == 'matched'
         && secondData.get('status', '') == 'matched'
         && firstData.get('callId', '') is string
         && firstData.get('callId', '').size() > 0
         && firstData.get('callId', '') == secondData.get('callId', '')
         && firstData.get('matchedBy', '') == secondData.get('matchedBy', '')
         && firstData.get('opponent', {}) is map
         && secondData.get('opponent', {}) is map
         && firstData.opponent.get('id', '') == secondId
          && secondData.opponent.get('id', '') == firstId
          && ((isRandomWebrtcQueue(firstData)
                && isRandomWebrtcQueue(secondData))
           || (isFriendWebrtcQueue(firstData, firstId)
               && isFriendWebrtcQueue(secondData, secondId)
               && firstData.targetUserId == secondId
               && secondData.targetUserId == firstId)
           || (isGameWebrtcQueue(firstData, firstId)
               && isGameWebrtcQueue(secondData, secondId)
               && firstData.targetUserId == secondId
               && secondData.targetUserId == firstId
               && firstData.gameType == secondData.gameType
               && firstData.gameRoomId == secondData.gameRoomId));
     }
     function canSetMatchedQueueEntry(userId) {
       let peerId = request.resource.data.get('opponent', {}).get('id', '');
       return request.auth != null
         && resource.data.get('status', '') == 'waiting'
         && request.resource.data.get('status', '') == 'matched'
         && request.resource.data.get('userId', '') == userId
         && request.resource.data.get('matchedBy', '') == request.auth.uid
         && request.resource.data.opponent is map
         && peerId != userId
         && request.auth.uid in [userId, peerId]
         && existsAfter(/databases/$(database)/documents/webrtcQueue/$(peerId))
         && hasReciprocalWebrtcQueue(userId, request.resource.data, peerId,
           getAfter(/databases/$(database)/documents/webrtcQueue/$(peerId)).data);
     }
    function hasNoOnboardingFields(data) {
      return !data.keys().hasAny(['gender', 'country', 'age']);
    }
    function hasValidProfileState(data) {
      return hasNoOnboardingFields(data) || hasCompletedOnboarding(data);
    }
     function hasNonNegativeBalances(data) {
       return (!data.keys().hasAny(['usdtBalance']) || (data.usdtBalance is number && data.usdtBalance >= 0))
         && (!data.keys().hasAny(['usdBalance']) || (data.usdBalance is number && data.usdBalance >= 0));
     }
       function hasSafeProfileValues(data, userId) {
        return hasNonNegativeBalances(data)
          && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() > 0 && data.name.size() <= 120))
          && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 320))
          && (!data.keys().hasAny(['image']) || (data.image is string && data.image.size() <= 2000))
           && hasSafeProfilePhotos(data, userId)
          && (!data.keys().hasAny(['isSubscribed']) || data.isSubscribed is bool)
         && (!data.keys().hasAny(['walletAddress']) || (data.walletAddress is string && data.walletAddress.size() == 34))
         && (!data.keys().hasAny(['walletNetwork']) || data.walletNetwork == 'TRC20')
          && (!data.keys().hasAny(['walletPublic']) || data.walletPublic is bool)
          && (!data.keys().hasAny(['defaultAiWritingPrompt']) || (data.defaultAiWritingPrompt is string && data.defaultAiWritingPrompt.size() <= 1200))
          && (!data.keys().hasAny(['musicFavorites']) || data.musicFavorites is list)
         && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
     }
     function hasNoServerManagedProfileChange() {
       return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
         'usdtBalance', 'usdBalance', 'lastTransferId', 'lastUsdOperationId', 'isSubscribed', 'premiumExpiresAt'
       ]);
     }
      function hasSafeProfileCreate(data, userId) {
        return data.keys().hasOnly([
            'name', 'email', 'image', 'profilePhotos', 'usdtBalance', 'usdBalance', 'isSubscribed', 'gender', 'genderPreference',
            'premiumExpiresAt', 'age', 'country', 'defaultAiWritingPrompt', 'walletAddress', 'walletNetwork', 'walletPublic', 'walletPinHash',
           'walletPinSalt', 'transferPinHash', 'transferPinSalt', 'musicFavorites', 'updatedAt'
         ])
         && data.keys().hasAll(['name', 'email', 'image', 'usdtBalance', 'usdBalance', 'isSubscribed', 'updatedAt'])
          && hasSafeProfileValues(data, userId)
         && data.usdtBalance == 0
         && data.usdBalance == 0
         && data.isSubscribed == false
         && hasValidProfileState(data);
     }
     function hasImmutableOnboardingFields() {
       return hasValidProfileState(request.resource.data)
         && (!hasValidGender(resource.data) || request.resource.data.gender == resource.data.gender)
         && (!hasValidAge(resource.data) || request.resource.data.age == resource.data.age)
         && (!hasValidCountry(resource.data) || request.resource.data.country == resource.data.country);
     }
    function hasNoWalletBalanceChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['usdtBalance', 'usdBalance', 'lastTransferId', 'lastUsdOperationId']);
    }
     function canInitializeUsdBalance(userId) {
       return request.auth != null
         && request.auth.uid == userId
        && !resource.data.keys().hasAny(['usdBalance'])
        && request.resource.data.usdBalance == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usdBalance', 'updatedAt']);
    }
       function isSafePublicProfile(data, userId) {
        return data.keys().hasOnly(['name', 'image', 'profilePhotos', 'gender', 'country', 'age', 'isSubscribed', 'isPublic', 'updatedAt', 'walletAddress', 'walletNetwork', 'walletPublic'])
        && data.keys().hasAll(['name', 'image', 'gender', 'country', 'isSubscribed', 'isPublic', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
         && data.image is string
          && hasSafeProfilePhotos(data, userId)
        && hasCompletedOnboarding(data)
         && data.isPublic == true
         && data.isSubscribed is bool
         && data.updatedAt is timestamp
         && (!data.keys().hasAny(['walletPublic']) || data.walletPublic == true)
         && (!data.keys().hasAny(['walletAddress']) || (data.walletAddress is string && data.walletAddress.size() == 34))
         && (!data.keys().hasAny(['walletNetwork']) || data.walletNetwork == 'TRC20')
         && (!data.keys().hasAny(['age']) || (data.age is int && data.age > 0 && data.age <= 130));
    }
      function publicProfileMatchesPrivate(userId) {
        return request.resource.data.gender == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.gender
          && request.resource.data.country == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.country
          && request.resource.data.age == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.age
          && request.resource.data.isSubscribed == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.isSubscribed
          && request.resource.data.get('profilePhotos', []) == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.get('profilePhotos', []);
     }
     function isSafePresence(data) {
      return data.keys().hasOnly(['userId', 'name', 'image', 'gender', 'country', 'age', 'lastSeenAt', 'updatedAt'])
        && data.keys().hasAll(['lastSeenAt', 'updatedAt'])
        && data.lastSeenAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(['userId'])
          || (
            data.keys().hasAll(['userId', 'name', 'image', 'gender', 'country', 'age'])
            && data.userId is string
            && data.name is string
            && data.image is string
            && hasCompletedOnboarding(data)
            && data.age is int
            && data.age >= 0
            && data.age <= 130
          )
        );
    }
    function presenceMatchesPrivate(data) {
      return data.gender == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.gender
        && data.country == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.country;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if isMaster() || (request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == resource.data.authorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
      ));
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /comments/{commentId} {
      function isIsoDate(value) {
        return value is string
          && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$');
      }
      function hasCommentSchema(data) {
        return data.keys().hasAll(['targetKey', 'parentId', 'authorId', 'authorName', 'body', 'createdAt', 'deleted'])
          && data.keys().hasOnly(['targetKey', 'parentId', 'authorId', 'authorName', 'body', 'createdAt', 'deleted', 'deletedAt'])
          && data.targetKey is string && data.targetKey.size() <= 512
          && data.targetKey.matches('^(posts|jobs|directories|marketItems|source):[^/\\s:]+$')
          && (data.parentId == null || (data.parentId is string && data.parentId.size() <= 512 && data.parentId.matches('^[^/\\s]+$')))
          && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
          && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
          && data.body is string && data.body.size() <= 2000
          && isIsoDate(data.createdAt) && data.deleted is bool
          && ((!data.deleted && data.body.size() > 0 && data.body.matches('[\\s\\S]*\\S[\\s\\S]*') && !data.keys().hasAny(['deletedAt']))
            || (data.deleted && data.body == '' && data.keys().hasAll(['deletedAt']) && isIsoDate(data.deletedAt)));
      }
      function hasExistingTarget(data) {
        let target = data.targetKey.split(':');
        // Live sources have no native document; their stable source ID is the discussion identity.
        return target[0] == 'source'
          || exists(/databases/$(database)/documents/$(target[0])/$(target[1]));
      }
      function hasSameThreadParent(data) {
        return data.parentId == null || (data.parentId != commentId
          && exists(/databases/$(database)/documents/comments/$(data.parentId))
          && get(/databases/$(database)/documents/comments/$(data.parentId)).data.targetKey == data.targetKey);
      }
      allow read: if true;
      allow create: if request.auth != null
        && hasCommentSchema(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.deleted == false
        && hasExistingTarget(request.resource.data)
        && hasSameThreadParent(request.resource.data);
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isMaster())
        && hasCommentSchema(request.resource.data)
        && resource.data.deleted == false && request.resource.data.deleted == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'deleted', 'deletedAt']);
      // Keep descendants, including replies written by other authors.
      allow delete: if false;
    }
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /marketItems/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /directories/{directoryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
    match /tetrisChatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
     match /webrtcChatMessages/{messageId} {
       allow read: if request.auth != null
         && exists(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId))
         && (get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.calleeId == request.auth.uid);
       allow create: if request.auth != null
         && isAdultUser(request.auth.uid)
         && isAccountAllowed(request.auth.uid)
         && request.resource.data.keys().hasOnly(['callId', 'authorId', 'user', 'text', 'createdAt', 'expiresAt'])
         && request.resource.data.authorId == request.auth.uid
         && request.resource.data.callId is string
         && request.resource.data.text is string
         && request.resource.data.text.size() > 0
         && request.resource.data.text.size() <= 500
         && request.resource.data.text.matches('[\\s\\S]*\\S[\\s\\S]*')
         && !request.resource.data.text.matches('(?i).*(https?://|www\\.|카카오톡|카톡|telegram|whatsapp|discord|디스코드|주소|우편번호|연락처|아이디).*')
         && !request.resource.data.text.matches('.*(01[016789][- .]?[0-9]{3,4}[- .]?[0-9]{4}).*')
         && exists(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId))
         && (get(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId)).data.calleeId == request.auth.uid);
       allow update: if false;
       allow delete: if request.auth != null
         && (isMaster()
           || resource.data.authorId == request.auth.uid
           || (resource.data.expiresAt is timestamp && request.time >= resource.data.expiresAt)
           || (exists(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId))
             && get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.status == 'ended'));
     }
     function hasValidDepositRequest(data) {
       return data.keys().hasOnly([
           'userId', 'amount', 'network', 'depositAddress', 'source', 'sourceWalletAddress', 'txHash', 'status',
           'createdAt', 'reviewedAt', 'reviewedBy'
         ])
         && data.keys().hasAll(['userId', 'amount', 'network', 'status', 'createdAt'])
         && data.userId is string
         && data.amount is number
         && data.amount > 0
         && data.amount <= 1000000
         && data.network == 'TRC20'
         && data.status == 'PENDING'
         && data.createdAt is timestamp
         && (!data.keys().hasAny(['depositAddress']) || (data.depositAddress is string && data.depositAddress.size() <= 100))
