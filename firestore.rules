rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null && request.auth.token.email == 'juyeonglee911029@gmail.com';
    }
    function isAdultUser(userId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.age is int
        && get(/databases/$(database)/documents/profiles/$(userId)).data.age >= 18;
    }
    function isAccountAllowed(userId) {
      return !exists(/databases/$(database)/documents/accountModeration/$(userId))
        || get(/databases/$(database)/documents/accountModeration/$(userId)).data.status == 'active'
        || (get(/databases/$(database)/documents/accountModeration/$(userId)).data.status == 'suspended'
          && get(/databases/$(database)/documents/accountModeration/$(userId)).data.until is timestamp
          && request.time >= get(/databases/$(database)/documents/accountModeration/$(userId)).data.until);
    }
    function hasValidGender(data) {
      return data.keys().hasAny(['gender']) && (data.gender == 'male' || data.gender == 'female');
    }
    function hasValidCountry(data) {
      return data.keys().hasAny(['country'])
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.country != 'Global';
    }
    function hasValidAge(data) {
      return data.keys().hasAny(['age'])
        && data.age is int
        && data.age >= 13
        && data.age <= 130;
    }
    function hasCompletedOnboarding(data) {
      return hasValidGender(data) && hasValidCountry(data) && hasValidAge(data);
    }
    function hasNoOnboardingFields(data) {
      return !data.keys().hasAny(['gender', 'country', 'age']);
    }
    function hasValidProfileState(data) {
      return hasNoOnboardingFields(data) || hasCompletedOnboarding(data);
    }
     function hasNonNegativeBalances(data) {
       return (!data.keys().hasAny(['usdtBalance']) || (data.usdtBalance is number && data.usdtBalance >= 0))
         && (!data.keys().hasAny(['usdBalance']) || (data.usdBalance is number && data.usdBalance >= 0));
     }
     function hasSafeProfileValues(data) {
       return hasNonNegativeBalances(data)
         && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() > 0 && data.name.size() <= 120))
         && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 320))
         && (!data.keys().hasAny(['image']) || (data.image is string && data.image.size() <= 2000))
         && (!data.keys().hasAny(['isSubscribed']) || data.isSubscribed is bool)
         && (!data.keys().hasAny(['walletAddress']) || (data.walletAddress is string && data.walletAddress.size() == 34))
         && (!data.keys().hasAny(['walletNetwork']) || data.walletNetwork == 'TRC20')
         && (!data.keys().hasAny(['walletPublic']) || data.walletPublic is bool)
         && (!data.keys().hasAny(['musicFavorites']) || data.musicFavorites is list)
         && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
     }
     function hasNoServerManagedProfileChange() {
       return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
         'usdtBalance', 'usdBalance', 'lastTransferId', 'lastUsdOperationId', 'isSubscribed', 'premiumExpiresAt'
       ]);
     }
     function hasSafeProfileCreate(data) {
       return data.keys().hasOnly([
           'name', 'email', 'image', 'usdtBalance', 'usdBalance', 'isSubscribed', 'gender', 'genderPreference',
           'premiumExpiresAt', 'age', 'country', 'walletAddress', 'walletNetwork', 'walletPublic', 'walletPinHash',
           'walletPinSalt', 'transferPinHash', 'transferPinSalt', 'musicFavorites', 'updatedAt'
         ])
         && data.keys().hasAll(['name', 'email', 'image', 'usdtBalance', 'usdBalance', 'isSubscribed', 'updatedAt'])
         && hasSafeProfileValues(data)
         && data.usdtBalance == 0
         && data.usdBalance == 0
         && data.isSubscribed == false
         && hasValidProfileState(data);
     }
     function hasImmutableOnboardingFields() {
       return hasValidProfileState(request.resource.data)
         && (!hasValidGender(resource.data) || request.resource.data.gender == resource.data.gender)
         && (!hasValidAge(resource.data) || request.resource.data.age == resource.data.age)
         && (!hasValidCountry(resource.data) || request.resource.data.country == resource.data.country);
     }
    function hasNoWalletBalanceChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['usdtBalance', 'usdBalance', 'lastTransferId', 'lastUsdOperationId']);
    }
     function canInitializeUsdBalance(userId) {
       return request.auth != null
         && request.auth.uid == userId
        && !resource.data.keys().hasAny(['usdBalance'])
        && request.resource.data.usdBalance == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usdBalance', 'updatedAt']);
    }
     function isSafePublicProfile(data) {
       return data.keys().hasOnly(['name', 'image', 'gender', 'country', 'age', 'isSubscribed', 'isPublic', 'updatedAt', 'walletAddress', 'walletNetwork', 'walletPublic'])
        && data.keys().hasAll(['name', 'image', 'gender', 'country', 'isSubscribed', 'isPublic', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.image is string
        && hasCompletedOnboarding(data)
         && data.isPublic == true
         && data.isSubscribed is bool
         && data.updatedAt is timestamp
         && (!data.keys().hasAny(['walletPublic']) || data.walletPublic == true)
         && (!data.keys().hasAny(['walletAddress']) || (data.walletAddress is string && data.walletAddress.size() == 34))
         && (!data.keys().hasAny(['walletNetwork']) || data.walletNetwork == 'TRC20')
         && (!data.keys().hasAny(['age']) || (data.age is int && data.age > 0 && data.age <= 130));
    }
     function publicProfileMatchesPrivate(userId) {
       return request.resource.data.gender == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.gender
         && request.resource.data.country == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.country
         && request.resource.data.age == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.age
         && request.resource.data.isSubscribed == getAfter(/databases/$(database)/documents/profiles/$(userId)).data.isSubscribed;
     }
     function isSafePresence(data) {
      return data.keys().hasOnly(['userId', 'name', 'image', 'gender', 'country', 'age', 'lastSeenAt', 'updatedAt'])
        && data.keys().hasAll(['lastSeenAt', 'updatedAt'])
        && data.lastSeenAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(['userId'])
          || (
            data.keys().hasAll(['userId', 'name', 'image', 'gender', 'country', 'age'])
            && data.userId is string
            && data.name is string
            && data.image is string
            && hasCompletedOnboarding(data)
            && data.age is int
            && data.age >= 0
            && data.age <= 130
          )
        );
    }
    function presenceMatchesPrivate(data) {
      return data.gender == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.gender
        && data.country == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.country;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if isMaster() || (request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == resource.data.authorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
      ));
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /comments/{commentId} {
      function isIsoDate(value) {
        return value is string
          && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$');
      }
      function hasCommentSchema(data) {
        return data.keys().hasAll(['targetKey', 'parentId', 'authorId', 'authorName', 'body', 'createdAt', 'deleted'])
          && data.keys().hasOnly(['targetKey', 'parentId', 'authorId', 'authorName', 'body', 'createdAt', 'deleted', 'deletedAt'])
          && data.targetKey is string && data.targetKey.size() <= 512
          && data.targetKey.matches('^(posts|jobs|directories|marketItems|source):[^/\\s:]+$')
          && (data.parentId == null || (data.parentId is string && data.parentId.size() <= 512 && data.parentId.matches('^[^/\\s]+$')))
          && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
          && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
          && data.body is string && data.body.size() <= 2000
          && isIsoDate(data.createdAt) && data.deleted is bool
          && ((!data.deleted && data.body.size() > 0 && data.body.matches('[\\s\\S]*\\S[\\s\\S]*') && !data.keys().hasAny(['deletedAt']))
            || (data.deleted && data.body == '' && data.keys().hasAll(['deletedAt']) && isIsoDate(data.deletedAt)));
      }
      function hasExistingTarget(data) {
        let target = data.targetKey.split(':');
        // Live sources have no native document; their stable source ID is the discussion identity.
        return target[0] == 'source'
          || exists(/databases/$(database)/documents/$(target[0])/$(target[1]));
      }
      function hasSameThreadParent(data) {
        return data.parentId == null || (data.parentId != commentId
          && exists(/databases/$(database)/documents/comments/$(data.parentId))
          && get(/databases/$(database)/documents/comments/$(data.parentId)).data.targetKey == data.targetKey);
      }
      allow read: if true;
      allow create: if request.auth != null
        && hasCommentSchema(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.deleted == false
        && hasExistingTarget(request.resource.data)
        && hasSameThreadParent(request.resource.data);
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isMaster())
        && hasCommentSchema(request.resource.data)
        && resource.data.deleted == false && request.resource.data.deleted == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'deleted', 'deletedAt']);
      // Keep descendants, including replies written by other authors.
      allow delete: if false;
    }
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /marketItems/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /directories/{directoryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster());
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
    match /tetrisChatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.expiresAt != null && request.time >= resource.data.expiresAt;
    }
     match /webrtcChatMessages/{messageId} {
       allow read: if request.auth != null
         && exists(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId))
         && (get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.calleeId == request.auth.uid);
       allow create: if request.auth != null
         && isAdultUser(request.auth.uid)
         && isAccountAllowed(request.auth.uid)
         && request.resource.data.keys().hasOnly(['callId', 'authorId', 'user', 'text', 'createdAt', 'expiresAt'])
         && request.resource.data.authorId == request.auth.uid
         && request.resource.data.callId is string
         && request.resource.data.text is string
         && request.resource.data.text.size() > 0
         && request.resource.data.text.size() <= 500
         && request.resource.data.text.matches('[\\s\\S]*\\S[\\s\\S]*')
         && !request.resource.data.text.matches('(?i).*(https?://|www\\.|카카오톡|카톡|telegram|whatsapp|discord|디스코드|주소|우편번호|연락처|아이디).*')
         && !request.resource.data.text.matches('.*(01[016789][- .]?[0-9]{3,4}[- .]?[0-9]{4}).*')
         && exists(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId))
         && (get(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId)).data.calleeId == request.auth.uid);
       allow update: if false;
       allow delete: if request.auth != null
         && (isMaster()
           || resource.data.authorId == request.auth.uid
           || (resource.data.expiresAt is timestamp && request.time >= resource.data.expiresAt)
           || (exists(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId))
             && get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.status == 'ended'));
     }
     function hasValidDepositRequest(data) {
       return data.keys().hasOnly([
           'userId', 'amount', 'network', 'depositAddress', 'source', 'sourceWalletAddress', 'txHash', 'status',
           'createdAt', 'reviewedAt', 'reviewedBy'
         ])
         && data.keys().hasAll(['userId', 'amount', 'network', 'status', 'createdAt'])
         && data.userId is string
         && data.amount is number
         && data.amount > 0
         && data.amount <= 1000000
         && data.network == 'TRC20'
         && data.status == 'PENDING'
         && data.createdAt is timestamp
         && (!data.keys().hasAny(['depositAddress']) || (data.depositAddress is string && data.depositAddress.size() <= 100))
         && (!data.keys().hasAny(['source']) || data.source == 'TRONCHAIN')
         && (!data.keys().hasAny(['sourceWalletAddress']) || (data.sourceWalletAddress is string && data.sourceWalletAddress.size() == 34))
         && (!data.keys().hasAny(['txHash']) || (data.txHash is string && data.txHash.size() >= 32 && data.txHash.size() <= 128));
     }
     function hasValidWithdrawalRequest(data) {
       return data.keys().hasOnly(['userId', 'amount', 'fee', 'targetAddress', 'network', 'status', 'createdAt', 'reviewedAt', 'reviewedBy'])
         && data.keys().hasAll(['userId', 'amount', 'fee', 'targetAddress', 'network', 'status', 'createdAt'])
         && data.userId is string
         && data.amount is number && data.amount > 0 && data.amount <= 1000000
         && data.fee is number && data.fee >= 0 && data.fee <= 1000
         && data.targetAddress is string && data.targetAddress.matches('^T[1-9A-HJ-NP-Za-km-z]{33}$')
         && data.network == 'TRC20'
         && data.status == 'PENDING'
         && data.createdAt is timestamp;
     }
     match /depositRequests/{requestId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       allow create: if request.auth != null && hasValidDepositRequest(request.resource.data)
         && ((request.resource.data.userId == request.auth.uid && !request.resource.data.keys().hasAny(['source', 'txHash', 'sourceWalletAddress']))
           || (isMaster() && request.resource.data.source == 'TRONCHAIN'
             && request.resource.data.txHash is string
             && request.resource.data.sourceWalletAddress is string));
       allow update: if isMaster()
         && request.resource.data.userId == resource.data.userId
         && request.resource.data.amount == resource.data.amount
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
         && request.resource.data.status in ['APPROVED', 'REJECTED']
         && request.resource.data.reviewedBy == request.auth.token.email;
       allow delete: if false;
     }
     match /walletVault/{userId} {
       allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
       allow create: if request.auth != null
         && request.auth.uid == userId
         && request.resource.data.keys().hasOnly(['userId', 'address', 'network', 'encryptedPrivateKey', 'iv', 'immutable', 'createdAt'])
         && request.resource.data.userId == userId
         && request.resource.data.address is string
         && request.resource.data.address.matches('^T[1-9A-HJ-NP-Za-km-z]{33}$')
         && request.resource.data.network == 'TRC20'
         && request.resource.data.encryptedPrivateKey is string
         && request.resource.data.iv is string
         && request.resource.data.immutable == true
         && request.resource.data.createdAt is timestamp;
       allow update, delete: if false;
     }
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
       allow create: if (isMaster() && hasNonNegativeBalances(request.resource.data))
         || (request.auth != null && request.auth.uid == userId && hasSafeProfileCreate(request.resource.data));
       allow update: if (isMaster() && hasNonNegativeBalances(request.resource.data))
         || canInitializeUsdBalance(userId)
         || (request.auth != null
           && request.auth.uid == userId
           && hasImmutableOnboardingFields()
           && hasSafeProfileValues(request.resource.data)
           && hasNoWalletBalanceChange()
           && hasNoServerManagedProfileChange());
      allow delete: if isMaster();
    }
    match /publicProfiles/{userId} {
      allow read: if resource.data.isPublic == true;
      allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isSafePublicProfile(request.resource.data)
        && publicProfileMatchesPrivate(userId);
      allow delete: if false;
    }
     match /withdrawalRequests/{requestId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       allow create: if request.auth != null
         && request.resource.data.userId == request.auth.uid
         && hasValidWithdrawalRequest(request.resource.data);
       allow update: if isMaster()
         && request.resource.data.userId == resource.data.userId
         && request.resource.data.amount == resource.data.amount
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
         && request.resource.data.status in ['APPROVED', 'REJECTED']
         && request.resource.data.reviewedBy == request.auth.token.email;
       allow delete: if false;
     }
     match /transferRequests/{requestId} {
       allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid || isMaster());
       // No verified settlement service exists for this legacy flow.
       allow create, update, delete: if false;
     }
     match /walletLedger/{entryId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       // Ledger entries are written by verified server/webhook code only.
       allow create, update, delete: if false;
     }
      match /paddlePayments/{paymentId} {
        allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
        allow create, update, delete: if false;
      }
      match /escrowOrders/{orderId} {
        allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isMaster());
        // Payment holding and lifecycle changes require a verified server settlement transaction.
        allow create, update, delete: if false;
      }
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isMaster();
    }
    match /contentSnapshots/{snapshotId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }
    match /stats/{statId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /presence/{visitorId} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeenAt', 'updatedAt'])
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /publicPresence/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && isSafePresence(request.resource.data)
        && presenceMatchesPrivate(request.resource.data);
      allow delete: if false;
    }
     match /userBlocks/{blockId} {
       allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
       allow create: if request.auth != null
         && request.resource.data.keys().hasOnly(['ownerId', 'blockedUserId', 'blockedName', 'callId', 'createdAt'])
         && request.resource.data.ownerId == request.auth.uid
         && request.resource.data.blockedUserId is string
         && request.resource.data.blockedUserId != request.auth.uid
         && request.resource.data.blockedName is string
         && request.resource.data.blockedName.size() <= 80
         && request.resource.data.createdAt is timestamp;
       allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
       allow update: if false;
     }
     match /safetyReports/{reportId} {
       allow read: if request.auth != null && (resource.data.reporterId == request.auth.uid || isMaster());
       allow create: if request.auth != null
         && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'callId', 'category', 'details', 'createdAt', 'status'])
         && request.resource.data.reporterId == request.auth.uid
         && request.resource.data.reportedUserId is string
         && request.resource.data.reportedUserId != request.auth.uid
         && request.resource.data.category in ['sexual_content', 'minor_safety', 'harassment', 'privacy', 'spam', 'other']
         && request.resource.data.details is string
         && request.resource.data.details.size() <= 500
         && request.resource.data.createdAt is timestamp
         && request.resource.data.status == 'open';
       allow update: if isMaster();
       allow delete: if false;
     }
     match /accountModeration/{userId} {
       allow read: if request.auth != null && (request.auth.uid == userId || isMaster());
       allow write: if isMaster();
     }
     match /safetyAuditLogs/{logId} {
       allow read: if isMaster();
       allow create: if request.auth != null
         && request.resource.data.keys().hasOnly(['actorId', 'action', 'targetUserId', 'callId', 'metadata', 'createdAt'])
         && request.resource.data.actorId == request.auth.uid
         && request.resource.data.action in ['report', 'block', 'call_start', 'call_end']
         && request.resource.data.metadata is string
         && request.resource.data.metadata.size() <= 500
         && request.resource.data.createdAt is timestamp;
       allow update, delete: if false;
     }
     match /webrtcQueue/{userId} {
       allow read: if request.auth != null && isAdultUser(request.auth.uid) && isAccountAllowed(request.auth.uid);
       allow create: if request.auth != null
         && request.auth.uid == userId
         && isAdultUser(request.auth.uid)
         && isAccountAllowed(request.auth.uid)
         && request.resource.data.userId == request.auth.uid
         && request.resource.data.age is int
         && request.resource.data.age >= 18;
       allow update: if request.auth != null
         && isAdultUser(request.auth.uid)
         && isAccountAllowed(request.auth.uid)
         && (request.auth.uid == userId
           || (resource.data.status == 'waiting'
             && request.resource.data.status == 'matched'
             && request.resource.data.matchedBy == request.auth.uid));
       allow delete: if request.auth != null && (request.auth.uid == userId || isMaster());
     }
     match /webrtcCalls/{callId} {
       allow read: if request.auth != null
         && isAdultUser(request.auth.uid)
         && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
       allow create: if request.auth != null
         && isAdultUser(request.auth.uid)
         && isAccountAllowed(request.auth.uid)
         && request.resource.data.callerId == request.auth.uid
         && request.resource.data.calleeId is string
         && isAdultUser(request.resource.data.calleeId);
       allow update: if request.auth != null
         && isAdultUser(request.auth.uid)
         && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['callId', 'callerId', 'calleeId', 'offer', 'answer', 'status', 'endedAt']);
       allow delete: if request.auth != null && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid || isMaster());
     }
      match /webrtcCandidates/{candidateId} {
       allow read: if request.auth != null
         && isAdultUser(request.auth.uid)
         && exists(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId))
         && (get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/webrtcCalls/$(resource.data.callId)).data.calleeId == request.auth.uid);
       allow create: if request.auth != null
         && isAdultUser(request.auth.uid)
         && request.resource.data.fromUserId == request.auth.uid
         && exists(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId))
         && (get(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId)).data.callerId == request.auth.uid
           || get(/databases/$(database)/documents/webrtcCalls/$(request.resource.data.callId)).data.calleeId == request.auth.uid);
       allow update: if false;
       allow delete: if request.auth != null
         && (isMaster() || resource.data.fromUserId == request.auth.uid);
     }
       match /liveRooms/{roomId} {
         allow read: if true;
          allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid
            && request.resource.data.title is string && request.resource.data.title.size() <= 10;
           allow update: if request.auth != null && (isMaster() ||
           (request.resource.data.status == 'offline'
             && resource.data.hostId == request.auth.uid
             && request.resource.data.hostId == null)
           || (request.resource.data.status == 'live'
             && request.resource.data.hostId == request.auth.uid
             && (resource.data.hostId == request.auth.uid
               || resource.data.status == 'offline'
               || (resource.data.updatedAt is timestamp
                 && request.time > resource.data.updatedAt + duration.value(20, 's'))))
           )
           || (request.auth != null
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
             && request.resource.data.likes is number
             && request.resource.data.likes >= 0);
          allow delete: if request.auth != null && (resource.data.hostId == request.auth.uid || isMaster());
      }
      match /liveRoomLikes/{likeId} {
        allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.roomId is string;
        allow update: if false;
        allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
      }
      match /liveRoomMessages/{messageId} {
       allow read: if true;
       allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
         allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isMaster() || get(/databases/$(database)/documents/liveRooms/$(resource.data.roomId)).data.hostId == request.auth.uid);
     }
     match /liveRoomRequests/{requestId} {
       allow read: if request.auth != null && (resource.data.requesterId == request.auth.uid || resource.data.helperId == request.auth.uid || isMaster());
       allow create: if request.auth != null && request.resource.data.requesterId == request.auth.uid;
       allow update: if request.auth != null && (resource.data.requesterId == request.auth.uid || resource.data.helperId == request.auth.uid || isMaster());
       allow delete: if false;
     }
      match /liveRoomViewers/{viewerId} {
         allow read: if request.auth != null && (
           isMaster()
           || resource.data.viewerId == request.auth.uid
           || resource.data.hostId == request.auth.uid
         );
        allow create: if request.auth != null
          && request.resource.data.viewerId == request.auth.uid
          && request.resource.data.hostId == get(/databases/$(database)/documents/liveRooms/$(request.resource.data.roomId)).data.hostId;
         allow update: if isMaster() || (request.auth != null && (
           resource.data.viewerId == request.auth.uid
           || resource.data.hostId == request.auth.uid
         ));
        allow delete: if isMaster() || (request.auth != null && (resource.data.viewerId == request.auth.uid || get(/databases/$(database)/documents/liveRooms/$(resource.data.roomId)).data.hostId == request.auth.uid));
     }
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.addresseeId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.addresseeId is string
        && request.resource.data.addresseeId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.addresseeId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
      allow delete: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.addresseeId == request.auth.uid);
    }
     match /friendMessages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants
        && get(/databases/$(database)/documents/friendships/$(resource.data.friendshipId)).data.status == 'accepted';
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.hasAll([
          get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.requesterId,
          get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.addresseeId
        ])
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.status == 'accepted';
      allow update: if false;
       allow delete: if request.auth != null
         && request.auth.uid in resource.data.participants
         && resource.data.expiresAt != null
         && request.time >= resource.data.expiresAt;
     }
      match /friendCallRequests/{requestId} {
       allow read: if request.auth != null
         && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
       allow create: if request.auth != null
         && request.resource.data.callerId == request.auth.uid
         && request.resource.data.calleeId is string
         && request.resource.data.calleeId != request.auth.uid
         && request.resource.data.status == 'pending';
       allow update: if request.auth != null
         && resource.data.calleeId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
         && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
       allow delete: if request.auth != null
         && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
       }
      function isBrickBreakerParticipant(data) {
        return request.auth != null && (
          (data.keys().hasAny(['host']) && data.host == request.auth.uid)
          || (data.keys().hasAny(['guest']) && data.guest == request.auth.uid)
        );
      }
      function hasValidBrickBreakerRoom(data) {
        return data.keys().hasAll(['host', 'guest', 'mode', 'seed', 'round', 'startAt', 'status', 'aborted', 'createdAt'])
          && data.host == request.auth.uid
          && data.guest == ''
          && data.mode in ['classic', 'items']
          && data.seed is number && data.seed >= 1 && data.seed <= 1000000
          && data.round == 1
          && data.startAt == 0
          && data.status == 'waiting'
          && data.aborted == false;
      }
      function canUpdateBrickBreakerRoom() {
        return request.auth != null
          && (isBrickBreakerParticipant(resource.data) || isBrickBreakerParticipant(request.resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guest', 'hostReady', 'guestReady', 'mode', 'seed', 'round', 'startAt', 'status', 'aborted',
            'betAmount', 'hostBetReady', 'guestBetReady', 'createdAt'
          ])
          && (
            (
              request.resource.data.status == resource.data.status
              && request.resource.data.status == 'waiting'
              && (!request.resource.data.keys().hasAny(['guest']) || resource.data.guest == '' || request.resource.data.guest == resource.data.guest)
            )
            || (request.resource.data.status == 'closed' && request.resource.data.aborted == true)
          );
      }
      match /brickBreakerQueue/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'waiting';
        allow update: if request.auth != null && (
          userId == request.auth.uid
          || (resource.data.status == 'waiting' && request.resource.data.status == 'matched' && request.resource.data.matchedBy == request.auth.uid)
        );
        allow delete: if request.auth != null && userId == request.auth.uid;
      }
      match /brickBreakerRooms/{roomId} {
        allow read: if isBrickBreakerParticipant(resource.data);
        allow create: if hasValidBrickBreakerRoom(request.resource.data);
        allow update: if (
          request.auth != null
          && request.resource.data.guest != ''
          && resource.data.guest == ''
          && request.resource.data.guest == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest'])
        ) || canUpdateBrickBreakerRoom();
        allow delete: if isBrickBreakerParticipant(resource.data);
      }
      match /brickBreakerRooms/{roomId}/signals/{signalId} {
        allow read: if request.auth != null
          && isBrickBreakerParticipant(get(/databases/$(database)/documents/brickBreakerRooms/$(roomId)).data);
        allow create: if request.auth != null
          && isBrickBreakerParticipant(get(/databases/$(database)/documents/brickBreakerRooms/$(roomId)).data)
          && request.resource.data.actor == request.auth.uid;
        allow update, delete: if false;
      }
      match /brickBreakerRooms/{roomId}/results/{resultId} {
        allow read: if request.auth != null
          && isBrickBreakerParticipant(get(/databases/$(database)/documents/brickBreakerRooms/$(roomId)).data);
        allow create, update, delete: if false;
      }
      match /tetrisLobby/{lobbyId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /tetrisQueue/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.status == 'waiting' && request.resource.data.status == 'matched' && request.resource.data.matchedBy == request.auth.uid)
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
     match /gameStakes/{stakeId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       allow create, update, delete: if false;
     }
     match /gamePayouts/{payoutId} {
       allow read: if request.auth != null && (resource.data.winnerId == request.auth.uid || resource.data.loserId == request.auth.uid || isMaster());
       // A client cannot declare a winner or mint a payout.
       allow create, update, delete: if false;
     }
     match /genderMatchStakes/{stakeId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       allow create, update, delete: if false;
     }
     match /premiumSubscriptions/{subscriptionId} {
       allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isMaster());
       allow create, update, delete: if false;
     }
     function hasValidTetrisScore(data) {
       return data.keys().hasOnly(['userId', 'name', 'country', 'score', 'lines', 'combo', 'mode', 'createdAt'])
         && data.keys().hasAll(['userId', 'name', 'country', 'score', 'lines', 'combo', 'mode', 'createdAt'])
         && data.userId is string
         && data.name is string && data.name.size() > 0 && data.name.size() <= 120
         && data.country is string && data.country.size() > 0 && data.country.size() <= 80
         && data.score is number && data.score >= 0 && data.score <= 1000000000
         && data.lines is number && data.lines >= 0 && data.lines <= 100000
         && data.combo is number && data.combo >= 0 && data.combo <= 10000
         && data.mode in ['practice', 'battle']
         && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40;
     }
     match /tetrisScores/{scoreId} {
       allow read: if true;
       // Scores are public, actor-bound, and immutable. Existing documents are untouched.
       allow create: if request.auth != null
         && request.resource.data.userId == request.auth.uid
         && hasValidTetrisScore(request.resource.data);
       allow update, delete: if false;
     }
     match /tetrisInvites/{inviteId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow delete: if false;
    }
      function isTetrisParticipant(data) {
        return request.auth != null && (
          (data.keys().hasAny(['playerAId']) && data.playerAId == request.auth.uid) ||
          (data.keys().hasAny(['playerBId']) && data.playerBId == request.auth.uid)
        );
      }
      function isFixedTetrisParticipant(roomId, data) {
        return request.auth != null
          && data.keys().hasAll(['roomNumber', 'matchId'])
          && data.matchId == roomId
          && get(/databases/$(database)/documents/tetrisRoomAccess/$(roomId)).data.active == true
          && (
            get(/databases/$(database)/documents/tetrisRoomAccess/$(roomId)).data.playerAId == request.auth.uid
            || get(/databases/$(database)/documents/tetrisRoomAccess/$(roomId)).data.playerBId == request.auth.uid
          );
      }
      function canAccessTetrisRoom(roomId, data) {
        return isTetrisParticipant(data) || isFixedTetrisParticipant(roomId, data);
      }
      function hasValidTetrisBet(data) {
        return data.keys().hasAny(['betAmount'])
          && data.betAmount is number
          && data.betAmount >= 1
          && data.betAmount <= 100;
      }
      function preservesTetrisBet() {
        return (
          !resource.data.keys().hasAny(['betAmount'])
          && !request.resource.data.keys().hasAny(['betAmount'])
        ) || (
          resource.data.keys().hasAny(['betAmount'])
          && request.resource.data.keys().hasAny(['betAmount'])
          && request.resource.data.betAmount == resource.data.betAmount
        ) || (
          !resource.data.keys().hasAny(['betAmount'])
          && request.auth.uid == request.resource.data.playerAId
          && hasValidTetrisBet(request.resource.data)
         );
      }
      function preservesTetrisSettlement() {
        return (
          !resource.data.keys().hasAny(['stakeHeldA', 'stakeHeldB', 'payoutStatus', 'payoutAmount'])
          && !request.resource.data.keys().hasAny(['stakeHeldA', 'stakeHeldB', 'payoutStatus', 'payoutAmount'])
        ) || (
          resource.data.keys().hasAll(['stakeHeldA', 'stakeHeldB', 'payoutStatus', 'payoutAmount'])
          && request.resource.data.keys().hasAll(['stakeHeldA', 'stakeHeldB', 'payoutStatus', 'payoutAmount'])
          && request.resource.data.stakeHeldA == resource.data.stakeHeldA
          && request.resource.data.stakeHeldB == resource.data.stakeHeldB
          && request.resource.data.payoutStatus == resource.data.payoutStatus
          && request.resource.data.payoutAmount == resource.data.payoutAmount
        );
      }
      match /tetrisRoomAccess/{matchId} {
        allow read: if request.auth != null && (
          resource.data.playerAId == request.auth.uid || resource.data.playerBId == request.auth.uid
        );
        allow create: if request.auth != null && (
          request.resource.data.playerAId == request.auth.uid || request.resource.data.playerBId == request.auth.uid
        );
        allow update: if request.auth != null && (
          resource.data.playerAId == request.auth.uid
          || resource.data.playerBId == request.auth.uid
          || request.resource.data.playerAId == request.auth.uid
          || request.resource.data.playerBId == request.auth.uid
        );
        allow delete: if false;
      }
      match /tetrisRooms/{roomId} {
        allow read: if canAccessTetrisRoom(roomId, resource.data);
         allow create: if canAccessTetrisRoom(roomId, request.resource.data)
           && !request.resource.data.keys().hasAny(['stakeHeldA', 'stakeHeldB', 'payoutStatus', 'payoutAmount'])
           && (!request.resource.data.keys().hasAny(['betAmount'])
             || (request.resource.data.playerAId == request.auth.uid && hasValidTetrisBet(request.resource.data)));
         allow update: if (canAccessTetrisRoom(roomId, resource.data) || canAccessTetrisRoom(roomId, request.resource.data))
           && preservesTetrisBet()
           && preservesTetrisSettlement();
        allow delete: if canAccessTetrisRoom(roomId, resource.data);
      }
  }
}
